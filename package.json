{
  "name": "green-farm",
  "version": "1.0.0",
  "description": "Фермерський магазин Green Farm: Express + вбудована SQLite (node:sqlite), JWT",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test unit.test.js api.test.js",
    "test:unit": "node --test unit.test.js",
    "test:api": "node --test api.test.js",
    "test:coverage": "node --test --experimental-test-coverage unit.test.js",
    "test:report": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=test-report.txt unit.test.js api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
